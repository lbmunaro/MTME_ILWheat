> # Create vectors with the unique environments included in each of the Tr2:Tr5 columns
> tr2 <- ILYT_PhenoTr |> filter(!is.na(Tr2)) |> droplevels() |> group_by(Env) |>
+   summarise(Env = unique(Env)) |> pull(Env); tr2
